{
  "title": "Pirates MLFlowOps - Model API",
  "uid": "pirates-model-api",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Prediction request rate (req/s)",
     "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
     "targets": [{"refId": "A", "legendFormat": "{{namespace}}",
       "expr": "sum by (namespace) (rate(pirates_prediction_requests_total[1m]))"}]},
    {"id": 2, "type": "timeseries", "title": "Prediction error rate (%)",
     "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
     "fieldConfig": {"defaults": {"unit": "percent", "min": 0}, "overrides": []},
     "targets": [{"refId": "A", "legendFormat": "{{namespace}}",
       "expr": "100 * (sum by (namespace) (rate(pirates_prediction_requests_total{status=\"error\"}[5m])) or sum by (namespace) (rate(pirates_prediction_requests_total[5m])) * 0) / sum by (namespace) (rate(pirates_prediction_requests_total[5m]))"}]},
    {"id": 3, "type": "stat", "title": "Model version in use",
     "gridPos": {"h": 6, "w": 8, "x": 0, "y": 8},
     "options": {"textMode": "name", "colorMode": "none", "graphMode": "none",
       "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
     "targets": [{"refId": "A", "legendFormat": "{{namespace}}: v{{model_version}}",
       "expr": "max by (namespace, model_version) (pirates_model_info)"}]},
    {"id": 4, "type": "timeseries", "title": "Latency p95 (s)",
     "gridPos": {"h": 6, "w": 16, "x": 8, "y": 8},
     "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
     "targets": [{"refId": "A", "legendFormat": "{{namespace}}",
       "expr": "histogram_quantile(0.95, sum by (le, namespace) (rate(pirates_prediction_latency_seconds_bucket[5m])))"}]},
    {"id": 5, "type": "timeseries", "title": "Drift: predicted class share (req/s by priority)",
     "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
     "targets": [{"refId": "A", "legendFormat": "{{namespace}} {{priority}}",
       "expr": "sum by (namespace, priority) (rate(pirates_predicted_class_total[5m]))"}]},
    {"id": 6, "type": "timeseries", "title": "Drift: average input text length (chars)",
     "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
     "targets": [{"refId": "A", "legendFormat": "avg length",
       "expr": "sum(rate(pirates_input_text_length_sum[5m])) / sum(rate(pirates_input_text_length_count[5m]))"}]}
  ]
}
